# ---------------------------------------------------------------------------
# 美刻科技官网 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ---------------------------------------------------------------------------

# 服务端口（默认 8700；原 zuyu 项目使用 8600 / 8080 / 8081，避免冲突）
APP_PORT=8700
APP_TIMEZONE=Asia/Shanghai

# 管理后台密码（部署前务必改成强密码）
ADMIN_PASSWORD=meike2026

# ---------------------------------------------------------------------------
# PostgreSQL（复用服务器上已有的 PG 服务，只建自己的库，不动其它库）
# 部署在 Docker 里时，PG_HOST 用 host.docker.internal（compose 已配 host-gateway）
# ---------------------------------------------------------------------------
PG_HOST=host.docker.internal
PG_PORT=5430
PG_USER=quant
PG_PASSWORD=
PG_DB=meishi_app
# 也可直接填完整连接串；填了会覆盖上面的 PG_* 拼装
DATABASE_URL=

# 构建镜像时的 pip 源（国内服务器建议使用镜像，避免 pypi.org 超时）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 是否启用关键词自动回复（人工回复后自动停用）
CHAT_AUTO_REPLY=true
# 单个 IP 每分钟最多发送的聊天消息数
MESSAGE_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# 用户手机号登录（短信验证码）
# ---------------------------------------------------------------------------
# 用户登录态签名密钥；建议设置一个随机长字符串（不设置则从 ADMIN_PASSWORD 派生）
USER_SESSION_SECRET=
# 登录态有效天数
USER_SESSION_DAYS=30
# 验证码有效期（秒），模板中如带“5 分钟”请保持一致
SMS_CODE_TTL_SECONDS=300
# auto: 配好腾讯云密钥就发真短信；没有密钥时，只有 SMS_DEBUG=true 才走本地 mock，
#       否则发送接口返回“短信服务未配置”，避免生产环境静默丢验证码
# tencent: 强制腾讯云；mock: 只写日志
SMS_PROVIDER=auto
# 本地调试设为 true 时，发送验证码接口会返回 debug_code，便于没有短信通道时登录；
# 生产环境必须为 false
SMS_DEBUG=false
# 模板 2744631 的参数：auto 先按“仅验证码”发，模板参数不匹配时自动重试“验证码+有效分钟数”
# 可选：auto / code / code,ttl
SMS_TEMPLATE_PARAMS=auto
# 腾讯云短信（云 API 密钥，不是 COS 账号密码）
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=1401204550
TENCENT_SMS_SIGN_NAME=云南美刻网络科技
# 登录验证码模板 ID
TENCENT_SMS_LOGIN_TEMPLATE_ID=2744631
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TIMEOUT=5

# ---------------------------------------------------------------------------
# 公司与联系方式（可留空；留空时页面只展示在线咨询入口）
# ---------------------------------------------------------------------------
COMPANY_NAME=云南美刻网络科技有限公司
COMPANY_SHORT=美刻科技
COMPANY_EN=MEIKE TECH
COMPANY_SLOGAN=把好想法，做成好产品
COMPANY_SERVICE_AREA=云南
COMPANY_PHONE=
COMPANY_WECHAT=
COMPANY_EMAIL=
COMPANY_ADDRESS=
# ICP 备案号，例如：滇ICP备2026xxxxxx号-1（备案后填写）
COMPANY_ICP=

# 线上域名（用于日志/后续扩展，可留空）
SITE_URL=
