# ---------------------------------------------------------------------------
# 美刻科技官网 · Nginx 反向代理示例
# 1. 把 server_name 换成你的已备案域名
# 2. 用 certbot 申请证书（HTTPS 是微信内置浏览器打开网页的基本要求）
# 3. 应用内端口是 8700，只在 127.0.0.1 上监听
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name meike.example.com;

    # certbot 的 HTTP-01 校验目录
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name meike.example.com;

    ssl_certificate     /etc/letsencrypt/live/meike.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meike.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;

    access_log /var/log/nginx/meike.access.log;
    error_log  /var/log/nginx/meike.error.log;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /static/ {
        proxy_pass http://127.0.0.1:8700;
        proxy_set_header Host $host;
        proxy_cache_valid 200 1h;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        proxy_pass http://127.0.0.1:8700;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
